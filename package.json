{
  "name": "adventure-studio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w studio -- --host 127.0.0.1 --port 3000",
    "build": "npm run build -w studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p apps/studio/tsconfig.json",
    "e2e": "playwright test",
    "prototype": "node --import tsx scripts/export-prototype.ts",
    "deploy": "npm run deploy -w studio"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "jszip": "^3.10.1",
    "lucide-react": "^1.70.0",
    "pdfkit": "^0.17.2",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/pdfkit": "^0.17.3",
    "@types/svg-to-pdfkit": "^0.1.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "fflate": "^0.7.5",
    "vite": "^8.3.6"
  }
}
