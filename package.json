{
  "name": "adventure-studio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w studio -- --host 127.0.0.1 --port 3000",
    "build": "npm run build -w studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p apps/studio/tsconfig.json",
    "e2e": "playwright test",
    "prototype": "tsx scripts/export-prototype.ts",
    "deploy": "npm run deploy -w studio"
  },
  "dependencies": {
    "zod": "^4.0.0",
    "pdfkit": "^0.17.2",
    "svg-to-pdfkit": "^0.1.8",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "vitest": "^4.0.0",
    "@playwright/test": "^1.56.0",
    "tsx": "^4.20.0",
    "@types/pdfkit": "^0.17.3",
    "@types/svg-to-pdfkit": "^0.1.3",
    "sharp": "^0.34.0"
  }
}
